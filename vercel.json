{
  "rewrites": [
    { "source": "/px/mi/:path*", "destination": "https://www.myinstants.com/:path*" },
    { "source": "/px/gmedia/:path*", "destination": "https://media.giphy.com/:path*" },
    { "source": "/px/yto", "destination": "https://www.youtube.com/oembed" },
    { "source": "/px/tto", "destination": "https://www.tiktok.com/oembed" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
